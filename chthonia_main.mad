// chthonia — the easy GUI to learn C and C++: a product built on madcide.
// Its program is this one unit (chthonia.json), which names the product and
// calls the base, linked with madcide's base, the library libmadcide.
//
// The descriptor is the whole difference from madcide: chthonia's name (its
// usage, its configuration directory), its bundle (the chthonia plugin: its
// keys, layout, menus, help and colours, all data), a window by default
// (--tui gives the console), and what Help ▸ About says — Chthonia, its own
// version and home page (chthonia_version.h, apart from madcide's and
// madc's), the copyright holder and the MPL-2.0 summary.
//
// Thread contract: <madcide/product>'s — main hands the descriptor to the
// base, which records it before any session or thread starts.
#include <madcide/product>
#include "chthonia_version.h"

const ide_product chthonia_product = { "chthonia", "chthonia", ui::WEB,
				       "", 0,
				       "Chthonia", CHTHONIA_VERSION,
				       CHTHONIA_HOME_PAGE,
				       "Derek Snider", MADCIDE_MPL2_SUMMARY };

int main(int argc, char **argv)
{
    return madcide_main(argc, argv, chthonia_product);
}
