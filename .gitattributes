# LF on every checkout, Windows included: the scripts, the test fixtures
# and the bundle files are read line by line, and a CR at a line's end
# becomes part of the value.
* text=auto eol=lf
*.ico binary

# GitHub's language statistics: Chthonia's code is C++ (its .mad source is
# a C++ dialect, and the header it includes); scripts/ is the build, test
# and packaging tooling, not counted.
*.mad linguist-language=C++
*.h linguist-language=C++
scripts/** linguist-detectable=false
